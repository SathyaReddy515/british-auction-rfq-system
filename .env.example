# Security
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=british_auction
DATABASE_URL=postgresql+psycopg2://postgres:replace-with-a-strong-database-password@localhost:5432/british_auction

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1
PORT=3000
